{
  "schema_version": "r1_global_baseline.v0.1",
  "status": "R1_GLOBAL_BASELINE=READY_NOT_EXECUTED",
  "baseline": {
    "baseline_id": "B1",
    "task": "ordinal",
    "pooling": "global_average",
    "encoder": "dinov3_vitb16",
    "tiny_test_encoder": "forbidden",
    "selection_split": "VAL",
    "held_out_split": "TEST"
  },
  "dataset": {
    "dataset_id": "mmrdr_uwf_v1",
    "dataset_config": "eyes-detected-models/configs/datasets/mmrdr_uwf_v1.yaml",
    "manifest_relative": "manifests/mmrdr_uwf_v2.jsonl",
    "targets_relative": "manifests/mmrdr_uwf_v2_targets.jsonl",
    "data_relative": "mmrdr/uwf",
    "split_contract": "released_patient_level_outer_test; validation is derived only within release training after identity audit",
    "label_contract": "grade is genuine ordinal 0-4; lesion list is image-level auxiliary presence only"
  },
  "storage_roots": {
    "data_env": "OCUFORGE_DATA_ROOT",
    "model_env": "OCUFORGE_MODEL_ROOT",
    "cache_env": "OCUFORGE_CACHE_ROOT",
    "artifact_env": "OCUFORGE_ARTIFACT_ROOT",
    "preferred_storage": "RunPod Network Volume or equivalent persistent public research filesystem",
    "provider_required": false,
    "layout": {
      "data": "mmrdr/uwf",
      "manifest": "manifests/mmrdr_uwf_v2.jsonl",
      "targets": "manifests/mmrdr_uwf_v2_targets.jsonl",
      "model": "dinov3",
      "features": "features/mmrdr_uwf_b1",
      "artifacts": "experiments/r1_global_b1"
    }
  },
  "encoder_config": "eyes-detected-models/configs/pipeline/r1-b1-extract-dino.json",
  "train_config": "eyes-detected-models/configs/pipeline/r1-b1-train.json",
  "protocol": "eyes-detected-contracts/protocols/ico_2017_dr.v0.1.json",
  "public_gpu_gate": {
    "execution_zone": "PUBLIC_CLOUD",
    "allowed_source_types": ["PUBLIC", "SYNTHETIC"],
    "private_data_allowed": false,
    "provisioning": false,
    "network_required_during_run": false,
    "weights_must_be_local_and_hashed": true
  },
  "commands": {
    "audit": "eyes-pipeline audit --manifest \"$OCUFORGE_DATA_ROOT/manifests/mmrdr_uwf_v2.jsonl\" --dataset eyes-detected-models/configs/datasets/mmrdr_uwf_v1.yaml --data-root \"$OCUFORGE_DATA_ROOT/mmrdr/uwf\" --out \"$OCUFORGE_ARTIFACT_ROOT/experiments/r1_global_b1/audit.json\" --cloud",
    "extract": "eyes-pipeline extract --manifest \"$OCUFORGE_DATA_ROOT/manifests/mmrdr_uwf_v2.jsonl\" --dataset eyes-detected-models/configs/datasets/mmrdr_uwf_v1.yaml --data-root \"$OCUFORGE_DATA_ROOT/mmrdr/uwf\" --config eyes-detected-models/configs/pipeline/r1-b1-extract-dino.json --out \"$OCUFORGE_CACHE_ROOT/features/mmrdr_uwf_b1\" --cloud",
    "train": "eyes-pipeline train --manifest \"$OCUFORGE_DATA_ROOT/manifests/mmrdr_uwf_v2.jsonl\" --dataset eyes-detected-models/configs/datasets/mmrdr_uwf_v1.yaml --targets \"$OCUFORGE_DATA_ROOT/manifests/mmrdr_uwf_v2_targets.jsonl\" --features \"$OCUFORGE_CACHE_ROOT/features/mmrdr_uwf_b1\" --config eyes-detected-models/configs/pipeline/r1-b1-train.json --protocol eyes-detected-contracts/protocols/ico_2017_dr.v0.1.json --out \"$OCUFORGE_ARTIFACT_ROOT/experiments/r1_global_b1/model\" --cloud",
    "evaluate": "eyes-pipeline evaluate --manifest \"$OCUFORGE_DATA_ROOT/manifests/mmrdr_uwf_v2.jsonl\" --dataset eyes-detected-models/configs/datasets/mmrdr_uwf_v1.yaml --targets \"$OCUFORGE_DATA_ROOT/manifests/mmrdr_uwf_v2_targets.jsonl\" --features \"$OCUFORGE_CACHE_ROOT/features/mmrdr_uwf_b1\" --checkpoint \"$OCUFORGE_ARTIFACT_ROOT/experiments/r1_global_b1/model/best.pt\" --split TEST --out \"$OCUFORGE_ARTIFACT_ROOT/experiments/r1_global_b1/evaluation\" --cloud",
    "report": "python scripts/r1_report.py --evaluation \"$OCUFORGE_ARTIFACT_ROOT/experiments/r1_global_b1/evaluation/evaluation.json\" --out \"$OCUFORGE_ARTIFACT_ROOT/experiments/r1_global_b1/report.json\"",
    "package": "python scripts/package_check.py --pre-report"
  }
}
